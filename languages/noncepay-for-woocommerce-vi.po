#. Plugin Name of the plugin
#: noncepay-for-woocommerce.php
msgid "NoncePay – Crypto Payment Gateway for WooCommerce"
msgstr "NoncePay – Cổng thanh toán tiền mã hóa cho WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: noncepay-for-woocommerce.php
msgid "https://noncepay.app/"
msgstr "https://noncepay.app/"

#. Description of the plugin
#: noncepay-for-woocommerce.php
msgid ""
"Accept crypto payments (USDT, USDC, BTC, ETH, SOL and more) sent straight to "
"your own wallets. Non-custodial, no account, no API key."
msgstr ""
"Nhận thanh toán bằng tiền mã hóa (USDT, USDC, BTC, ETH, SOL và nhiều loại "
"khác) gửi thẳng vào ví của chính bạn. Không lưu ký, không cần tài khoản, "
"không cần khóa API."

#. Author of the plugin
#: noncepay-for-woocommerce.php includes/class-noncepay-payment-page.php:141
msgid "NoncePay"
msgstr "NoncePay"

#: includes/class-noncepay-api.php:158
msgid ""
"The crypto payment service is unreachable. Please try again in a moment."
msgstr ""
"Không thể kết nối tới dịch vụ thanh toán tiền mã hóa. Vui lòng thử lại sau "
"giây lát."

#: includes/class-noncepay-api.php:166
msgid ""
"The crypto payment service returned an unexpected response. Please try again "
"in a moment."
msgstr ""
"Dịch vụ thanh toán tiền mã hóa trả về phản hồi không mong muốn. Vui lòng thử "
"lại sau giây lát."

