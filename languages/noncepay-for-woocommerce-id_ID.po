#. Plugin Name of the plugin
#: noncepay-for-woocommerce.php
msgid "NoncePay – Crypto Payment Gateway for WooCommerce"
msgstr "NoncePay – Gateway Pembayaran Kripto untuk WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: noncepay-for-woocommerce.php
msgid "https://noncepay.app/"
msgstr "https://noncepay.app/"

#. Description of the plugin
#: noncepay-for-woocommerce.php
msgid ""
"Accept crypto payments (USDT, USDC, BTC, ETH, SOL and more) sent straight to "
"your own wallets. Non-custodial, no account, no API key."
msgstr ""
"Terima pembayaran kripto (USDT, USDC, BTC, ETH, SOL, dan lainnya) langsung ke"
" dompet Anda sendiri. Non-kustodial, tanpa akun, tanpa kunci API."

#. Author of the plugin
#: noncepay-for-woocommerce.php includes/class-noncepay-payment-page.php:141
msgid "NoncePay"
msgstr "NoncePay"

#: includes/class-noncepay-api.php:158
msgid ""
"The crypto payment service is unreachable. Please try again in a moment."
msgstr ""
"Layanan pembayaran kripto tidak dapat dijangkau. Silakan coba lagi sebentar "
"lagi."

#: includes/class-noncepay-api.php:166
msgid ""
"The crypto payment service returned an unexpected response. Please try again "
"in a moment."
msgstr ""
"Layanan pembayaran kripto memberikan respons yang tidak terduga. Silakan coba"
" lagi sebentar lagi."

