#. Plugin Name of the plugin
#: noncepay-for-woocommerce.php
msgid "NoncePay – Crypto Payment Gateway for WooCommerce"
msgstr "NoncePay – Gateway de pagamento em cripto para WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: noncepay-for-woocommerce.php
msgid "https://noncepay.app/"
msgstr "https://noncepay.app/"

#. Description of the plugin
#: noncepay-for-woocommerce.php
msgid ""
"Accept crypto payments (USDT, USDC, BTC, ETH, SOL and more) sent straight to"
" your own wallets. Non-custodial, no account, no API key."
msgstr ""
"Aceite pagamentos em cripto (USDT, USDC, BTC, ETH, SOL e mais) enviados "
"direto para suas próprias carteiras. Sem custódia, sem conta, sem chave de "
"API."

#. Author of the plugin
#: noncepay-for-woocommerce.php includes/class-noncepay-payment-page.php:141
msgid "NoncePay"
msgstr "NoncePay"

#: includes/class-noncepay-api.php:158
msgid ""
"The crypto payment service is unreachable. Please try again in a moment."
msgstr ""
"O serviço de pagamento em cripto está inacessível. Tente novamente em "
"instantes."

#: includes/class-noncepay-api.php:166
msgid ""
"The crypto payment service returned an unexpected response. Please try again"
" in a moment."
msgstr ""
"O serviço de pagamento em cripto retornou uma resposta inesperada. Tente "
"novamente em instantes."

