#. Plugin Name of the plugin
#: noncepay-for-woocommerce.php
msgid "NoncePay – Crypto Payment Gateway for WooCommerce"
msgstr "NoncePay – Gateway di pagamento crypto per WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: noncepay-for-woocommerce.php
msgid "https://noncepay.app/"
msgstr "https://noncepay.app/"

#. Description of the plugin
#: noncepay-for-woocommerce.php
msgid ""
"Accept crypto payments (USDT, USDC, BTC, ETH, SOL and more) sent straight to "
"your own wallets. Non-custodial, no account, no API key."
msgstr ""
"Accetta pagamenti in criptovalute (USDT, USDC, BTC, ETH, SOL e altre) inviati"
" direttamente ai tuoi wallet. Non custodial, nessun account, nessuna chiave "
"API."

#. Author of the plugin
#: noncepay-for-woocommerce.php includes/class-noncepay-payment-page.php:141
msgid "NoncePay"
msgstr "NoncePay"

#: includes/class-noncepay-api.php:158
msgid ""
"The crypto payment service is unreachable. Please try again in a moment."
msgstr ""
"Il servizio di pagamento crypto non è raggiungibile. Riprova tra qualche "
"istante."

#: includes/class-noncepay-api.php:166
msgid ""
"The crypto payment service returned an unexpected response. Please try again "
"in a moment."
msgstr ""
"Il servizio di pagamento crypto ha restituito una risposta inattesa. Riprova "
"tra qualche istante."

