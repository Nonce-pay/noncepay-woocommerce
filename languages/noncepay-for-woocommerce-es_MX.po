#. Plugin Name of the plugin
#: noncepay-for-woocommerce.php
msgid "NoncePay – Crypto Payment Gateway for WooCommerce"
msgstr "NoncePay – Pasarela de pago con criptomonedas para WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: noncepay-for-woocommerce.php
msgid "https://noncepay.app/"
msgstr "https://noncepay.app/"

#. Description of the plugin
#: noncepay-for-woocommerce.php
msgid ""
"Accept crypto payments (USDT, USDC, BTC, ETH, SOL and more) sent straight to"
" your own wallets. Non-custodial, no account, no API key."
msgstr ""
"Acepta pagos con criptomonedas (USDT, USDC, BTC, ETH, SOL y más) enviados "
"directamente a tus propios monederos. Sin custodia, sin cuenta y sin clave "
"de API."

#. Author of the plugin
#: noncepay-for-woocommerce.php includes/class-noncepay-payment-page.php:141
msgid "NoncePay"
msgstr "NoncePay"

#: includes/class-noncepay-api.php:158
msgid ""
"The crypto payment service is unreachable. Please try again in a moment."
msgstr ""
"El servicio de pago con criptomonedas no está disponible. Inténtalo de nuevo"
" en un momento."

#: includes/class-noncepay-api.php:166
msgid ""
"The crypto payment service returned an unexpected response. Please try again"
" in a moment."
msgstr ""
"El servicio de pago con criptomonedas ha devuelto una respuesta inesperada. "
"Inténtalo de nuevo en un momento."

